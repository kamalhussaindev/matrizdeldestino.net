---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import SchemaBreadcrumb from '../../components/seo/SchemaBreadcrumb.astro';
import SchemaFAQ from '../../components/seo/SchemaFAQ.astro';
import SchemaSoftwareApp from '../../components/seo/SchemaSoftwareApp.astro';
import FaqAccordion from '../../components/content/FaqAccordion.astro';
import RelatedCalculators from '../../components/content/RelatedCalculators.astro';
import PersonalYearCalculator from '../../components/calculator/PersonalYearCalculator';
import { personalYearFaq } from '../../data/faq';
import { calculators } from '../../data/calculators';

const breadcrumbItems = [
  { label: 'Calculators', href: '/calculadoras/' },
  { label: 'Personal Year Number' },
];

const relatedCalculators = calculators.filter((c) => c.slug !== 'personal-year-number');
---

<BaseLayout
  title="Personal Year Number Calculator 2026 — What's Your Year? | Arcania"
  description="Find your personal year number for 2026 free. Discover your numerology forecast, yearly theme, and what to focus on in your personal year cycle."
>
  <SchemaBreadcrumb slot="schema" items={breadcrumbItems} />
  <SchemaFAQ slot="schema" qa={personalYearFaq} />
  <SchemaSoftwareApp
    slot="schema"
    name="Personal Year Number Calculator"
    description="Free personal year number calculator based on date of birth and the current year, with yearly theme, focus, and cycle position."
  />

  <Breadcrumbs items={breadcrumbItems} />

  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <h1 class="font-heading text-4xl font-bold text-ink sm:text-5xl">Personal Year Number Calculator</h1>
    <div class="mt-4 flex flex-col gap-3 text-lg text-ink-muted">
      <p>
        Your personal year number reveals the theme of this specific year for you — whether it's a time
        to start fresh, build foundations, or release what no longer serves you. Enter your day and month
        of birth to find your personal year number instantly, for free.
      </p>
    </div>
  </div>

  <div class="mx-auto mt-8 max-w-3xl px-4 sm:px-6">
    <PersonalYearCalculator client:visible />
  </div>

  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h2 class="font-heading text-2xl font-bold text-ink sm:text-3xl">How it's calculated</h2>
    <div class="mt-4 flex flex-col gap-4 text-ink-muted">
      <p>
        We add together the digits of your birth day, your birth month, and the current calendar year,
        then reduce that total to a single digit by repeatedly summing its digits — stopping early if the
        total lands on the master number 11 or 22.
      </p>
      <p>
        Because the calendar year changes every year, your personal year number changes too — moving you
        through a repeating 9-year cycle, from 1 (new beginnings) through 9 (completion), before starting
        again. Your birth year isn't part of this calculation, only your day and month. All calculation
        happens instantly in your browser; we never store your date of birth.
      </p>
    </div>
  </section>

  <FaqAccordion qa={personalYearFaq} />

  <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
    <p class="rounded-xl bg-surface-alt px-5 py-4 text-sm text-ink-muted">
      This calculator is a self-knowledge tool and should not be interpreted as a form of divination or
      fortune-telling. Want a deeper reading? Try the full
      <a href="/matriz-del-destino/" class="font-medium text-primary hover:underline">Matriz del Destino calculator →</a>
    </p>
  </section>

  <RelatedCalculators items={relatedCalculators} />
</BaseLayout>
