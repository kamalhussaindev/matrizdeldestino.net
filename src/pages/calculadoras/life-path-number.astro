---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import SchemaBreadcrumb from '../../components/seo/SchemaBreadcrumb.astro';
import SchemaFAQ from '../../components/seo/SchemaFAQ.astro';
import SchemaSoftwareApp from '../../components/seo/SchemaSoftwareApp.astro';
import FaqAccordion from '../../components/content/FaqAccordion.astro';
import RelatedCalculators from '../../components/content/RelatedCalculators.astro';
import LifePathCalculator from '../../components/calculator/LifePathCalculator';
import { lifePathFaq } from '../../data/faq';
import { calculators } from '../../data/calculators';

const breadcrumbItems = [
  { label: 'Calculators', href: '/calculadoras/' },
  { label: 'Life Path Number' },
];

const relatedCalculators = calculators.filter((c) => c.slug !== 'life-path-number');
---

<BaseLayout
  title="Free Life Path Number Calculator — What Is Your Life Path? | Arcania"
  description="Calculate your life path number free. Enter your date of birth and discover your numerology life path meaning, master numbers, and compatibility."
  noindex
>
  <SchemaBreadcrumb slot="schema" items={breadcrumbItems} />
  <SchemaFAQ slot="schema" qa={lifePathFaq} />
  <SchemaSoftwareApp
    slot="schema"
    name="Life Path Number Calculator"
    description="Free life path number calculator based on date of birth, with meaning, master numbers, and compatibility."
  />

  <Breadcrumbs items={breadcrumbItems} />

  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <h1 class="font-heading text-4xl font-bold text-ink sm:text-5xl">Life Path Number Calculator</h1>
    <div class="mt-4 flex flex-col gap-3 text-lg text-ink-muted">
      <p>
        Your life path number is the single most important number in numerology — a snapshot of your
        core personality, natural talents, and the lessons you're here to learn. Enter your date of
        birth below to calculate yours instantly, for free.
      </p>
    </div>
  </div>

  <div class="mx-auto mt-8 max-w-3xl px-4 sm:px-6">
    <LifePathCalculator client:visible />
  </div>

  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h2 class="font-heading text-2xl font-bold text-ink sm:text-3xl">How it's calculated</h2>
    <div class="mt-4 flex flex-col gap-4 text-ink-muted">
      <p>
        We add together every digit of your full birth date — day, month, and year — and reduce that
        total to a single digit by repeatedly summing its digits. The one exception: if the total lands
        on 11, 22, or 33 at any point, we stop there, since these are considered master numbers and
        traditionally aren't reduced any further.
      </p>
      <p>
        For example, someone born on May 15, 1990 sums to 1+5 + 5 + 1+9+9+0 = 30, which reduces to
        3 + 0 = 3 — a Life Path 3. All calculation happens instantly in your browser; we never store your
        date of birth.
      </p>
    </div>
  </section>

  <FaqAccordion qa={lifePathFaq} />

  <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
    <p class="rounded-xl bg-surface-alt px-5 py-4 text-sm text-ink-muted">
      This calculator is a self-knowledge tool and should not be interpreted as a form of divination or
      fortune-telling. Want a deeper reading? Try the full
      <a href="/matriz-del-destino/" class="font-medium text-primary hover:underline">Matriz del Destino calculator →</a>
    </p>
  </section>

  <RelatedCalculators items={relatedCalculators} />
</BaseLayout>
