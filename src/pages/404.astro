---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Page Not Found | Arcania"
  description="The page you're looking for doesn't exist or was moved. Head back to Arcania to calculate your Matriz del Destino, browse the 22 arcana, or read our guides."
>
  <div class="mx-auto flex max-w-xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <h1 class="font-heading text-4xl font-bold text-ink sm:text-5xl">Page Not Found</h1>
    <p class="mt-4 text-lg text-ink-muted">The page you're looking for doesn't exist or was moved.</p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <Button href="/matriz-del-destino/">Calculate My Matriz del Destino →</Button>
      <Button href="/arcanos/" variant="secondary">View the 22 Arcana →</Button>
      <Button href="/guias/" variant="secondary">Read the Guides →</Button>
    </div>
  </div>
</BaseLayout>
