---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import SchemaBreadcrumb from '../components/seo/SchemaBreadcrumb.astro';
import Card from '../components/ui/Card.astro';

const breadcrumbItems = [{ label: 'Contact' }];
---

<BaseLayout
  title="Contact Arcania"
  description="Write to us with your questions, suggestions, or feedback about the Matriz del Destino and our calculators."
  noindex
>
  <SchemaBreadcrumb slot="schema" items={breadcrumbItems} />

  <Breadcrumbs items={breadcrumbItems} />

  <article class="mx-auto max-w-2xl px-4 pb-16 sm:px-6">
    <h1 class="font-heading text-4xl font-bold text-ink sm:text-5xl">Contact</h1>
    <p class="mt-4 text-lg text-ink-muted">
      Have a question or suggestion? Get in touch with us — we read every message.
    </p>

    <Card class="mt-8">
      <h2 class="font-heading text-lg font-semibold text-ink">Email</h2>
      <p class="mt-2 text-ink-muted">
        <a href="mailto:hola@matrizdeldestino.net" class="font-medium text-primary hover:underline">
          hola@matrizdeldestino.net
        </a>
      </p>
      <p class="mt-4 text-sm text-ink-muted">
        We reply within 2 to 3 business days. If your question is about how to interpret a specific
        position in your matrix, let us know which position and which arcana you got so we can help you
        better.
      </p>
    </Card>
  </article>
</BaseLayout>
