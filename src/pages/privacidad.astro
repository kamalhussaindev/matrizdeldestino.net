---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import SchemaBreadcrumb from '../components/seo/SchemaBreadcrumb.astro';

const breadcrumbItems = [{ label: 'Privacy' }];
const lastUpdated = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(new Date('2026-01-01'));
---

<BaseLayout
  title="Privacy Policy | Arcania"
  description="What data Arcania collects, how we use it, and what your rights are as a user of our calculators."
  noindex
>
  <SchemaBreadcrumb slot="schema" items={breadcrumbItems} />

  <Breadcrumbs items={breadcrumbItems} />

  <article class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
    <h1 class="font-heading text-4xl font-bold text-ink sm:text-5xl">Privacy Policy</h1>
    <p class="mt-2 text-sm text-ink-muted">Last updated: {lastUpdated}</p>

    <div class="mt-6 flex flex-col gap-4 text-ink-muted">
      <h2 class="font-heading text-2xl font-bold text-ink">Current state of data collection</h2>
      <p>
        The PDF report form currently doesn't transmit or store email addresses. This feature is still
        under development. Your Matriz del Destino calculation happens locally on your device.
      </p>

      <h2 class="font-heading text-2xl font-bold text-ink">What data we collect</h2>
      <p>
        To calculate your Matriz del Destino, we only need your date of birth and, optionally, a name to
        personalise the result on screen. This calculation happens entirely in your browser: your date of
        birth is never sent to our servers or stored in any database.
      </p>

      <h2 class="font-heading text-2xl font-bold text-ink">What we don't do</h2>
      <p>
        We don't sell, rent, or share your personal data with third parties for commercial purposes. We
        don't use your date of birth for any purpose other than what you explicitly authorised by using
        it.
      </p>

      <h2 class="font-heading text-2xl font-bold text-ink">Cookies and analytics</h2>
      <p>
        Where enabled, we use aggregate analytics tools (such as Google Analytics) solely to understand,
        in aggregate, how the site is used — which pages are visited most, from which devices — so we can
        improve it. The site works the same whether or not they're enabled. We don't use this information
        to identify you individually or for third-party advertising purposes.
      </p>

      <h2 class="font-heading text-2xl font-bold text-ink">Your rights</h2>
      <p>
        Since we don't collect or store identifiable personal data, we have no data of yours to correct
        or delete. If you have any questions about this policy, reach us through our
        <a href="/contacto/" class="font-medium text-primary hover:underline">contact page</a>.
      </p>

      <h2 class="font-heading text-2xl font-bold text-ink">Changes to this policy</h2>
      <p>
        If we update this policy in a significant way, we'll note it on this same page with a new update
        date.
      </p>
    </div>
  </article>
</BaseLayout>
