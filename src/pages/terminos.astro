---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import SchemaBreadcrumb from '../components/seo/SchemaBreadcrumb.astro';

const breadcrumbItems = [{ label: 'Terms' }];
const lastUpdated = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(new Date('2026-01-01'));
---

<BaseLayout
  title="Terms of Use | Arcania"
  description="Terms and conditions for using Arcania's calculators and content."
  noindex
>
  <SchemaBreadcrumb slot="schema" items={breadcrumbItems} />

  <Breadcrumbs items={breadcrumbItems} />

  <article class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
    <h1 class="font-heading text-4xl font-bold text-ink sm:text-5xl">Terms of Use</h1>
    <p class="mt-2 text-sm text-ink-muted">Last updated: {lastUpdated}</p>

    <div class="mt-6 flex flex-col gap-4 text-ink-muted">
      <h2 class="font-heading text-2xl font-bold text-ink">Nature of the service</h2>
      <p>
        Arcania offers calculators and content related to the Matriz del Destino for entertainment and
        self-knowledge purposes. It does not constitute professional advice of any kind — medical,
        psychological, financial, legal, or otherwise — and should not be used as a substitute for such
        advice.
      </p>

      <h2 class="font-heading text-2xl font-bold text-ink">No guarantee of accuracy</h2>
      <p>
        While we strive for our calculations to faithfully replicate the standard Matriz del Destino
        model (see our <a href="/metodo/" class="font-medium text-primary hover:underline">method page</a>),
        we don't guarantee that results are accurate, complete, or fit for any particular purpose. Use of
        our calculators and interpretations is at your own discretion and risk.
      </p>

      <h2 class="font-heading text-2xl font-bold text-ink">Permitted use</h2>
      <p>
        You may use our calculators freely for personal, non-commercial purposes. Automated scraping of
        our content or interpretations for republishing or reuse in other products is not permitted
        without prior written authorisation.
      </p>

      <h2 class="font-heading text-2xl font-bold text-ink">Intellectual property</h2>
      <p>
        The text, interpretations, visual design, and code on this site are the property of Arcania,
        except where otherwise noted. The Matriz del Destino method itself — originally developed by
        Natalia Ladini — is in the public domain as a system; our particular implementation of the
        calculation and our written interpretations are not.
      </p>

      <h2 class="font-heading text-2xl font-bold text-ink">Changes to the service</h2>
      <p>
        We may modify, suspend, or discontinue any part of our services at any time, including free or
        paid features, without prior notice.
      </p>

      <h2 class="font-heading text-2xl font-bold text-ink">Contact</h2>
      <p>
        If you have questions about these terms, reach us through our
        <a href="/contacto/" class="font-medium text-primary hover:underline">contact page</a>.
      </p>
    </div>
  </article>
</BaseLayout>
