---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaFAQ from '../components/seo/SchemaFAQ.astro';
import SchemaSoftwareApp from '../components/seo/SchemaSoftwareApp.astro';
import UnifiedCalculator from '../components/calculator/UnifiedCalculator';
import ArcanoDelDia from '../components/content/ArcanoDelDia.astro';
import HowItWorks from '../components/content/HowItWorks.astro';
import FaqAccordion from '../components/content/FaqAccordion.astro';
import BlogStrip from '../components/content/BlogStrip.astro';
import { homeFaq } from '../data/faq';
import { INDEXABLE_BLOG_SLUGS } from '../data/indexable';

// Only the indexable posts are linked from here: the homepage is the page we
// want ranking, so its outbound links should feed the other 5 indexed pages,
// not the noindexed archive.
const latestPosts = (await getCollection('blog'))
  .filter((post) => INDEXABLE_BLOG_SLUGS.includes(post.slug))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .map((post) => ({
    title: post.data.title,
    excerpt: post.data.metaDescription,
    href: `/blog/${post.slug}/`,
    heroImage: post.data.heroImage,
  }));
---

<BaseLayout
  title="Matriz del Destino — Calculadora Gratis con los 22 Arcanos | Arcania"
  description="Calcula tu Matriz del Destino gratis con fecha de nacimiento. Descubre tus 22 arcanos, cola kármica, línea del amor y propósito de vida al instante."
  canonicalPath="/"
  showMobileStickyBar
>
  <SchemaFAQ slot="schema" qa={homeFaq} />
  <SchemaSoftwareApp
    slot="schema"
    name="Calculadora de la Matriz del Destino"
    description="Calculadora gratuita de la Matriz del Destino a partir de la fecha de nacimiento, con interpretación de cada posición del octagrama y cálculo de compatibilidad de pareja."
  />

  <section id="calculadora" class="mx-auto max-w-5xl px-4 pb-4 pt-10 sm:px-6 sm:pt-14">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="font-heading text-2xl font-bold text-ink sm:text-3xl">
        Calculadora de la Matriz del Destino
      </h1>
      <p class="mx-auto mt-3 max-w-xl text-base text-ink-muted">
        Ingresa tu fecha de nacimiento y descubre tus 22 arcanos, tu cola kármica y tu propósito de
        vida al instante.
      </p>
    </div>

    <div class="mt-8">
      <UnifiedCalculator client:load />
    </div>
  </section>

  <div class="pb-4 pt-6">
    <ArcanoDelDia />
  </div>

  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <h2 class="font-heading text-2xl font-bold text-ink">¿Qué es la Matriz del Destino?</h2>
    <div class="mt-4 flex flex-col gap-4 text-ink-muted">
      <p>
        La Matriz del Destino es un sistema de autoconocimiento creado en 2006 por la numeróloga rusa
        Natalia Ladini. Combina numerología, los 22 arcanos mayores del tarot y energía de los chakras
        para construir un mapa simbólico — el octagrama — a partir de un solo dato: tu fecha de
        nacimiento.
      </p>
      <p>
        El método reduce tu día, mes y año de nacimiento a números del 1 al 22, y los distribuye en las
        posiciones del octagrama. Cada posición representa un aspecto distinto de tu vida —
        personalidad, talentos, propósito, relaciones y tu relación con el dinero — interpretado
        cruzando su significado con el arcano correspondiente.
      </p>
    </div>
    <a
      href="/guias/que-es-la-matriz-del-destino/"
      class="mt-5 inline-block font-medium text-primary hover:underline"
    >
      Leer la guía completa →
    </a>
  </section>

  <HowItWorks />

  <FaqAccordion qa={homeFaq} />

  <BlogStrip posts={latestPosts} />
</BaseLayout>
