---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaFAQ from '../components/seo/SchemaFAQ.astro';
import Hero from '../components/content/Hero.astro';
import Button from '../components/ui/Button.astro';
import ValuePropCards from '../components/content/ValuePropCards.astro';
import ExampleResult from '../components/content/ExampleResult.astro';
import BenefitsGrid from '../components/content/BenefitsGrid.astro';
import HowItWorks from '../components/content/HowItWorks.astro';
import TrustSignals from '../components/content/TrustSignals.astro';
import ArcanoDelDia from '../components/content/ArcanoDelDia.astro';
import FaqAccordion from '../components/content/FaqAccordion.astro';
import RelatedCalculators from '../components/content/RelatedCalculators.astro';
import BlogStrip from '../components/content/BlogStrip.astro';
import { homeFaq } from '../data/faq';
import { calculators } from '../data/calculators';

// The homepage is now a brand/informational hub (the calculator itself lives
// on /matriz-del-destino/), so all calculators — including the main one —
// belong in this rail.
const relatedCalculators = calculators;

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3)
  .map((post) => ({
    title: post.data.title,
    excerpt: post.data.metaDescription,
    href: `/blog/${post.slug}/`,
    heroImage: post.data.heroImage,
  }));
---

<BaseLayout
  title="Matriz del Destino Calculator — Free English Reading | Arcania"
  description="Calculate your Matriz del Destino free in English. Discover your 22 arcana, karmic tail, life purpose, love line and money line — instant results, no sign up."
  preloadImage="/images/homepage/hero-calculadora-matriz-del-destino.webp"
>
  <SchemaFAQ slot="schema" qa={homeFaq} />

  <Hero
    title="Discover Your Matriz del Destino"
    subtitle="A self-knowledge system that reveals your personality, purpose, and energies from your date of birth and the 22 major arcana."
    backgroundImage="/images/homepage/hero-calculadora-matriz-del-destino.webp"
  >
    <Button href="/matriz-del-destino/" size="lg">Calculate My Matriz del Destino →</Button>
  </Hero>

  <div class="pt-8">
    <ArcanoDelDia />
  </div>

  <ValuePropCards />
  <ExampleResult />
  <BenefitsGrid />
  <HowItWorks />
  <TrustSignals />

  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h2 class="font-heading text-2xl font-bold text-ink sm:text-3xl">What is the Matriz del Destino?</h2>
    <div class="mt-4 flex flex-col gap-4 text-ink-muted">
      <p>
        The Matriz del Destino is a self-knowledge system created in 2006 by Russian numerologist Natalia
        Ladini. It combines numerology, the 22 major arcana of the tarot, and chakra energy to build a
        symbolic map — the octagram — from a single piece of data: your date of birth.
      </p>
      <p>
        The method reduces your day, month, and year of birth to numbers from 1 to 22, then distributes
        them across the positions of the octagram. Each position represents a different aspect of your
        life — personality, talents, purpose, relationships, and your relationship with money —
        interpreted by crossing its meaning with the corresponding arcana.
      </p>
      <p>
        Want to go deeper? Visit our complete guide on <a href="/guias/que-es-la-matriz-del-destino/" class="font-medium text-primary hover:underline">what the Matriz del Destino is</a>,
        or explore the meaning of each of the <a href="/arcanos/" class="font-medium text-primary hover:underline">22 major arcana</a>.
      </p>
    </div>
  </section>

  <FaqAccordion qa={homeFaq} />
  <RelatedCalculators items={relatedCalculators} />
  <BlogStrip posts={latestPosts} />

  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <div class="rounded-2xl bg-gradient-to-br from-primary to-primary-dark px-6 py-10 text-center text-white sm:px-12">
      <h2 class="font-heading text-2xl font-bold sm:text-3xl">The PDF Report is Coming</h2>
      <p class="mx-auto mt-3 max-w-xl text-white/85">
        We are preparing a more complete downloadable report. This feature will be available soon.
      </p>
      <button
        type="button"
        disabled
        class="mx-auto mt-6 rounded-xl bg-white/10 px-6 py-3 text-sm font-semibold text-white/70 disabled:cursor-not-allowed"
      >
        Coming soon
      </button>
    </div>
  </section>
</BaseLayout>
