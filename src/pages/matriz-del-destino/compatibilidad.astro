---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import SchemaBreadcrumb from '../../components/seo/SchemaBreadcrumb.astro';
import SchemaFAQ from '../../components/seo/SchemaFAQ.astro';
import SchemaSoftwareApp from '../../components/seo/SchemaSoftwareApp.astro';
import FaqAccordion from '../../components/content/FaqAccordion.astro';
import RelatedCalculators from '../../components/content/RelatedCalculators.astro';
import CompatibilityCalculator from '../../components/calculator/CompatibilityCalculator';
import { compatibilityFaq } from '../../data/faq';
import { calculators } from '../../data/calculators';

const breadcrumbItems = [
  { label: 'Matriz del Destino', href: '/matriz-del-destino/' },
  { label: 'Couple Compatibility' },
];

const relatedCalculators = calculators.filter((c) => c.slug !== 'compatibilidad');
---

<BaseLayout
  title="Free Destiny Matrix Compatibility Calculator | Arcania"
  description="Compare your Matriz del Destino with your partner's. Discover your shared energies, relationship dynamics and compatibility — free, instant, no sign up."
>
  <SchemaBreadcrumb slot="schema" items={breadcrumbItems} />
  <SchemaFAQ slot="schema" qa={compatibilityFaq} />
  <SchemaSoftwareApp
    slot="schema"
    name="Matriz del Destino Compatibility Calculator"
    description="Free couple compatibility calculator based on both people's Matriz del Destino."
  />

  <Breadcrumbs items={breadcrumbItems} />

  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <h1 class="font-heading text-4xl font-bold text-ink sm:text-5xl">
      Matriz del Destino: Couple Compatibility
    </h1>
    <p class="mt-4 text-lg text-ink-muted">
      Calculate both people's Matriz del Destino and discover which arcana they share, which energies
      complement each other, and what their combination says about the relationship.
    </p>
  </div>

  <div class="mx-auto mt-8 max-w-4xl px-4 sm:px-6">
    <CompatibilityCalculator client:visible />
  </div>

  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h2 class="font-heading text-2xl font-bold text-ink sm:text-3xl">How does compatibility work?</h2>
    <div class="mt-4 flex flex-col gap-4 text-ink-muted">
      <p>
        We calculate each person's Matriz del Destino separately, using the same method as our
        <a href="/matriz-del-destino/" class="font-medium text-primary hover:underline">main calculator</a>.
        We then compare their central arcana and the rest of their main positions to identify matches and
        differences between the two energies.
      </p>
      <p>
        A shared arcana in a key position usually signals a natural affinity in that area of life. A
        difference isn't a bad sign: it almost always indicates complementarity — that each person brings
        something the other doesn't have.
      </p>
    </div>
  </section>

  <FaqAccordion qa={compatibilityFaq} />

  <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
    <p class="rounded-xl bg-surface-alt px-5 py-4 text-sm text-ink-muted">
      This calculator is a self-knowledge tool and should not be interpreted as a form of divination or
      fortune-telling about the relationship's future.
    </p>
  </section>

  <RelatedCalculators items={relatedCalculators} />
</BaseLayout>
