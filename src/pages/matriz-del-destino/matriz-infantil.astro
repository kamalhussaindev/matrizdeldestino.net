---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import SchemaBreadcrumb from '../../components/seo/SchemaBreadcrumb.astro';
import SchemaFAQ from '../../components/seo/SchemaFAQ.astro';
import SchemaSoftwareApp from '../../components/seo/SchemaSoftwareApp.astro';
import FaqAccordion from '../../components/content/FaqAccordion.astro';
import RelatedCalculators from '../../components/content/RelatedCalculators.astro';
import MatrixCalculator from '../../components/calculator/MatrixCalculator';
import { childFaq } from '../../data/faq';
import { calculators } from '../../data/calculators';

const breadcrumbItems = [
  { label: 'Matriz del Destino', href: '/matriz-del-destino/' },
  { label: 'Child Matrix' },
];

const relatedCalculators = calculators.filter((c) => c.slug !== 'matriz-infantil');
---

<BaseLayout
  title="Free Child Destiny Matrix Calculator | Arcania"
  description="Calculate your child's Matriz del Destino free. Discover their natural talents, life purpose, and best development path from their date of birth."
>
  <SchemaBreadcrumb slot="schema" items={breadcrumbItems} />
  <SchemaFAQ slot="schema" qa={childFaq} />
  <SchemaSoftwareApp
    slot="schema"
    name="Child Matriz del Destino Calculator"
    description="Free Matriz del Destino calculator designed to discover children's talents and purpose."
  />

  <Breadcrumbs items={breadcrumbItems} />

  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <h1 class="font-heading text-4xl font-bold text-ink sm:text-5xl">Child Matriz del Destino</h1>
    <p class="mt-4 text-lg text-ink-muted">
      Discover your child's natural talents and purpose with the same Matriz del Destino, in a reading
      designed to support their growth through care and observation, not comparison.
    </p>
  </div>

  <div class="mx-auto mt-8 max-w-3xl px-4 sm:px-6">
    <MatrixCalculator
      client:visible
      nameLabel="Child's name (optional)"
      namePlaceholder="Your child's name"
      submitLabel="Calculate Child Matrix →"
    />
  </div>

  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h2 class="font-heading text-2xl font-bold text-ink sm:text-3xl">A tool for support, not labels</h2>
    <div class="mt-4 flex flex-col gap-4 text-ink-muted">
      <p>
        The Child Matriz del Destino uses exactly the same calculation as our
        <a href="/matriz-del-destino/" class="font-medium text-primary hover:underline">main calculator</a>,
        based on your child's date of birth. What changes is the lens: we invite you to read each
        position as a seed of talent in development, not as a fixed destiny or a definitive label.
      </p>
      <p>
        Knowing a child's dominant energies from an early age can help you recognise their natural
        inclinations — creative, social, analytical, or physical — and support them at their own pace,
        rather than comparing them to siblings or peers.
      </p>
      <p>
        Remember that this tool is a starting point for observation and family conversation, not a
        substitute for guidance from a child psychology professional.
      </p>
    </div>
  </section>

  <FaqAccordion qa={childFaq} />

  <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
    <p class="rounded-xl bg-surface-alt px-5 py-4 text-sm text-ink-muted">
      This calculator is a self-knowledge and support tool, not a clinical diagnosis or a form of
      divination about your child's future.
    </p>
  </section>

  <RelatedCalculators items={relatedCalculators} />
</BaseLayout>
