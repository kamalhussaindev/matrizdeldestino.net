---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import SchemaBreadcrumb from '../../components/seo/SchemaBreadcrumb.astro';
import ArcanaCard from '../../components/content/ArcanaCard.astro';

const breadcrumbItems = [{ label: 'Arcana' }];

const arcanos = (await getCollection('arcanos')).sort((a, b) => a.data.numero - b.data.numero);
---

<BaseLayout
  title="The 22 Major Arcana of the Matriz del Destino | Arcania"
  description="Explore the meaning of each of the 22 major arcana in the Matriz del Destino. Discover what each arcana reveals about your personality, purpose, and karmic patterns."
  showMobileStickyBar
  noindex
>
  <SchemaBreadcrumb slot="schema" items={breadcrumbItems} />

  <Breadcrumbs items={breadcrumbItems} />

  <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
    <h1 class="font-heading text-4xl font-bold text-ink sm:text-5xl">The 22 Major Arcana</h1>
    <p class="mt-4 text-lg text-ink-muted">
      Each position in your Matriz del Destino is interpreted through one of the 22 major arcana. Click
      any arcana to discover its meaning.
    </p>
  </div>

  <div class="mx-auto mt-10 grid max-w-5xl gap-6 px-4 pb-16 sm:grid-cols-2 sm:px-6 lg:grid-cols-3">
    {
      arcanos.map((entry) => (
        <ArcanaCard
          numero={entry.data.numero}
          nombre={entry.data.nombre}
          description={entry.data.metaDescription ?? `Discover the meaning of Arcana ${entry.data.numero} in your Matriz del Destino.`}
          href={`/arcanos/${entry.data.numero}/`}
          heroImage={entry.data.heroImage}
        />
      ))
    }
  </div>
</BaseLayout>
