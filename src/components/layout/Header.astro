---
// [MARCA] placeholder — replace "Arcania" with the final brand name.
// Deliberately minimal: the homepage is the calculator, so there is no
// "Calculadora" nav item and no CTA button — the calculator below is the CTA.
const navItems = [
  { label: 'Guías', href: '/guias/que-es-la-matriz-del-destino/' },
  { label: 'Blog', href: '/blog/matriz-del-destino-2026/' },
];
---

<header class="sticky top-0 z-50 border-b border-surface-alt bg-surface/95 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 font-heading text-xl font-bold text-primary">
      <svg viewBox="0 0 24 24" class="h-6 w-6 text-accent" aria-hidden="true">
        <path
          d="M12 1l3.5 7.5L23 12l-7.5 3.5L12 23l-3.5-7.5L1 12l7.5-3.5z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linejoin="round"
        />
      </svg>
      Arcania
    </a>

    <nav aria-label="Principal" class="flex items-center gap-6">
      {
        navItems.map((item) => (
          <a href={item.href} class="text-sm font-medium text-ink hover:text-primary">
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
