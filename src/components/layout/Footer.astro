---
// [MARCA] placeholder — replace "Arcania" with the final brand name.
const calculadoras = [
  { label: 'Matriz del Destino', href: '/matriz-del-destino/' },
  { label: 'Couple Compatibility', href: '/matriz-del-destino/compatibilidad/' },
  { label: 'Child Matrix', href: '/matriz-del-destino/matriz-infantil/' },
  { label: 'All Calculators', href: '/calculadoras/' },
];

const guias = [
  { label: 'What is the Matriz del Destino?', href: '/guias/que-es-la-matriz-del-destino/' },
  { label: 'How to calculate your matrix', href: '/guias/como-calcular-la-matriz-del-destino/' },
  { label: 'How to read your matrix', href: '/guias/como-leer-la-matriz-del-destino/' },
  { label: 'Karmic tail', href: '/guias/cola-karmica/' },
  { label: 'Ancestral square', href: '/guias/cuadrado-ancestral/' },
  { label: 'Complete example', href: '/guias/ejemplo-completo-matriz-del-destino/' },
  { label: 'Wellbeing line', href: '/guias/linea-de-bienestar/' },
  { label: 'Point E and comfort zone', href: '/guias/punto-e-zona-de-confort/' },
  { label: 'Money line', href: '/guias/linea-del-dinero/' },
];

const empresa = [
  { label: 'About us', href: '/sobre-nosotros/' },
  { label: 'Our method', href: '/metodo/' },
  { label: 'Contact', href: '/contacto/' },
  { label: 'Privacy', href: '/privacidad/' },
  { label: 'Terms', href: '/terminos/' },
];

const ARCANA_NAMES = [
  'The Magician',
  'The High Priestess',
  'The Empress',
  'The Emperor',
  'The Hierophant',
  'The Lovers',
  'The Chariot',
  'Strength',
  'The Hermit',
  'Wheel of Fortune',
  'Justice',
  'The Hanged Man',
  'Death',
  'Temperance',
  'The Devil',
  'The Tower',
  'The Star',
  'The Moon',
  'The Sun',
  'Judgement',
  'The World',
  'The Fool',
];

const arcanos = Array.from({ length: 22 }, (_, i) => i + 1);

const year = new Date().getFullYear();
---

<footer class="border-t border-surface-alt bg-white">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-12 sm:px-6 md:grid-cols-4">
    <div>
      <h2 class="font-heading text-sm font-semibold text-ink">Calculators</h2>
      <ul class="mt-4 flex flex-col gap-2">
        {
          calculadoras.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-ink-muted hover:text-primary">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="font-heading text-sm font-semibold text-ink">Arcana</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-3 gap-y-2">
        {
          arcanos.map((n) => (
            <li>
              <a href={`/arcanos/${n}/`} class="text-sm text-ink-muted hover:text-primary">
                {n} · {ARCANA_NAMES[n - 1]}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/arcanos/" class="mt-4 inline-block text-sm font-medium text-primary hover:underline">
        View all arcana →
      </a>
    </div>

    <div>
      <h2 class="font-heading text-sm font-semibold text-ink">Guides</h2>
      <ul class="mt-4 flex flex-col gap-2">
        {
          guias.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-ink-muted hover:text-primary">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="font-heading text-sm font-semibold text-ink">Company</h2>
      <ul class="mt-4 flex flex-col gap-2">
        {
          empresa.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-ink-muted hover:text-primary">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-surface-alt px-4 py-6 sm:px-6">
    <p class="mx-auto max-w-6xl text-xs text-ink-muted">
      © {year} Arcania. Self-knowledge tool; not a substitute for professional advice.
    </p>
    <p class="mx-auto mt-2 max-w-6xl text-xs text-ink-muted">
      Available worldwide.
    </p>
  </div>
</footer>
