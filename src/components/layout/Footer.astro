---
// [MARCA] placeholder — replace "Arcania" with the final brand name.
// Only indexed destinations are linked here. The 22 arcana and the full
// guide list used to sit in this footer; both are noindexed, so linking
// them sitewide spent crawl budget on pages we do not want ranking.
const calculadora = [{ label: 'Calcular Matriz del Destino', href: '/' }];

const guias = [
  { label: '¿Qué es la Matriz del Destino?', href: '/guias/que-es-la-matriz-del-destino/' },
  { label: 'Cómo calcular tu matriz', href: '/guias/como-calcular-la-matriz-del-destino/' },
  { label: 'Cola kármica', href: '/guias/cola-karmica/' },
];

const blog = [
  { label: 'Matriz del Destino 2026', href: '/blog/matriz-del-destino-2026/' },
  { label: 'Combinaciones de la cola kármica', href: '/blog/cola-karmica-combinaciones-numeros/' },
];

const empresa = [
  { label: 'Sobre nosotros', href: '/sobre-nosotros/' },
  { label: 'Contacto', href: '/contacto/' },
  { label: 'Privacidad', href: '/privacidad/' },
  { label: 'Términos', href: '/terminos/' },
];

const columns = [
  { heading: 'Calculadora', items: calculadora },
  { heading: 'Guías', items: guias },
  { heading: 'Blog', items: blog },
  { heading: 'Empresa', items: empresa },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-surface-alt bg-white">
  <div class="mx-auto grid max-w-5xl grid-cols-2 gap-8 px-4 py-12 sm:px-6 md:grid-cols-4">
    {
      columns.map((column) => (
        <div>
          <h2 class="font-heading text-sm font-semibold text-ink">{column.heading}</h2>
          <ul class="mt-4 flex flex-col gap-2">
            {column.items.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-ink-muted hover:text-primary">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="border-t border-surface-alt px-4 py-6 sm:px-6">
    <p class="mx-auto max-w-5xl text-xs text-ink-muted">
      © {year} Arcania. Herramienta de autoconocimiento; no sustituye asesoría profesional.
    </p>
  </div>
</footer>
