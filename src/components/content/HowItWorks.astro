---
const steps = [
  {
    title: 'Enter your date',
    body: 'Select your date of birth. Your name is optional.',
  },
  {
    title: 'Instant calculation',
    body: 'We calculate your complete octagram in your browser — no waiting, no server calls.',
  },
  {
    title: 'Personalised interpretation',
    body: 'Explore each position and discover which arcana lives there and what it means for your life.',
  },
];
---

<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
  <h2 class="text-center font-heading text-2xl font-bold text-ink sm:text-3xl">How It Works</h2>
  <ol class="mt-10 grid gap-8 sm:grid-cols-3">
    {
      steps.map((step, index) => (
        <li class="text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary font-heading text-lg font-bold text-white">
            {index + 1}
          </div>
          <h3 class="mt-4 font-heading text-lg font-semibold text-ink">{step.title}</h3>
          <p class="mt-2 text-sm text-ink-muted">{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>
