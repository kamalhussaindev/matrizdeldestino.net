---
const steps = [
  {
    title: 'Ingresa tu fecha',
    body: 'Selecciona el día, mes y año en que naciste. El nombre es opcional.',
  },
  {
    title: 'Cálculo instantáneo',
    body: 'Tu octagrama se calcula en tu navegador. Sin esperas y sin enviar tu fecha a ningún servidor.',
  },
  {
    title: 'Interpretación posición por posición',
    body: 'Haz clic en cualquier punto del octagrama y descubre qué arcano vive ahí y qué significa para ti.',
  },
];
---

<section class="section max-w-5xl">
  <div class="mx-auto max-w-2xl text-center">
    <p class="section-eyebrow">Cómo funciona</p>
    <h2 class="mt-3 font-heading text-2xl font-bold text-ink sm:text-3xl">
      Tres pasos, menos de un minuto
    </h2>
  </div>

  <ol class="relative mt-12 grid gap-10 sm:grid-cols-3 sm:gap-6">
    {/* The connector only makes sense once the steps sit side by side. */}
    <div
      class="absolute left-0 right-0 top-6 hidden h-px bg-gradient-to-r from-transparent via-surface-alt to-transparent sm:block"
      aria-hidden="true"
    >
    </div>

    {
      steps.map((step, index) => (
        <li class="relative text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-primary/15 bg-white font-heading text-lg font-bold text-primary shadow-sm">
            {index + 1}
          </div>
          <h3 class="mt-5 font-heading text-lg font-semibold text-ink">{step.title}</h3>
          <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-ink-muted">{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>
