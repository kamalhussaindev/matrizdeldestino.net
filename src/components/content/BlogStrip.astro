---
import { Image } from 'astro:assets';
import Badge from '../ui/Badge.astro';

export interface BlogPostPreview {
  title: string;
  excerpt: string;
  href: string;
  heroImage?: string;
}

export interface Props {
  posts?: BlogPostPreview[];
}

// Placeholder cards until Milestone 5 wires the real blog content
// collection in. Structurally ready: just pass `posts` once real entries
// exist and this section renders them instead.
const defaultPosts: BlogPostPreview[] = [
  {
    title: 'Próximamente',
    excerpt: 'Estamos preparando artículos sobre numerología, arcanos y autoconocimiento.',
    href: '/blog/',
  },
  {
    title: 'Próximamente',
    excerpt: 'Pronto encontrarás aquí guías prácticas para interpretar tu matriz.',
    href: '/blog/',
  },
  {
    title: 'Próximamente',
    excerpt: 'Historias y ejemplos reales de lecturas de la Matriz del Destino.',
    href: '/blog/',
  },
];

const { posts = defaultPosts } = Astro.props;

// The rail is fed a variable number of cards (the homepage links only the
// indexable posts), so the column count follows the card count.
const gridCols = posts.length === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-3';
---

<section class="section max-w-5xl">
  <div class="mx-auto max-w-2xl text-center">
    <p class="section-eyebrow">Sigue leyendo</p>
    <h2 class="mt-3 font-heading text-2xl font-bold text-ink sm:text-3xl">Del blog</h2>
  </div>
  <div class={`mt-12 grid gap-6 ${gridCols}`}>
    {
      posts.map((post) => (
        <a href={post.href} class="card-surface card-surface-hover flex flex-col overflow-hidden">
          <div class="aspect-[600/400] overflow-hidden">
            {post.heroImage ? (
              <Image
                src={post.heroImage}
                alt={post.title}
                width={600}
                height={400}
                widths={[300, 450, 600]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
                loading="lazy"
                class="h-full w-full object-cover"
              />
            ) : (
              <div class="h-full w-full bg-gradient-to-br from-primary to-accent" />
            )}
          </div>
          <div class="flex flex-1 flex-col p-5">
            <Badge variant="outline">Blog</Badge>
            <h3 class="mt-3 font-heading text-lg font-semibold leading-snug text-ink">{post.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">{post.excerpt}</p>
            <span class="mt-4 text-sm font-semibold text-primary">Leer artículo →</span>
          </div>
        </a>
      ))
    }
  </div>
</section>
