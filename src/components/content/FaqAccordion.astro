---
import type { FaqItem } from '../../data/faq';

export interface Props {
  heading?: string;
  eyebrow?: string;
  qa: FaqItem[];
}

const { heading = 'Preguntas Frecuentes', eyebrow, qa } = Astro.props;
---

<section class="section max-w-3xl">
  <div class="mx-auto max-w-2xl text-center">
    {eyebrow && <p class="section-eyebrow">{eyebrow}</p>}
    <h2 class="mt-3 font-heading text-2xl font-bold text-ink sm:text-3xl">{heading}</h2>
  </div>

  <div class="mt-10 flex flex-col gap-3">
    {
      qa.map((item) => (
        <details class="faq-item card-surface group overflow-hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-sans font-semibold text-ink marker:content-none">
            <span>{item.question}</span>
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-surface text-primary transition-transform duration-200 group-open:rotate-180">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4"
                aria-hidden="true"
              >
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </span>
          </summary>
          <p class="border-t border-surface-alt px-5 py-4 leading-relaxed text-ink-muted">
            {item.answer}
          </p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  /* Hover lift on a full-width accordion row reads as jitter, so the
     shared .card-surface transform is suppressed here. */
  .faq-item:hover {
    transform: none;
  }
</style>
