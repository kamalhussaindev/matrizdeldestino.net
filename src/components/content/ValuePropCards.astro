---
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';

const items = [
  {
    icon: 'sparkle' as const,
    title: 'Self-Knowledge',
    body: 'Discover your personality, talents, and life purpose from a unique map calculated from your date of birth.',
  },
  {
    icon: 'compass' as const,
    title: '22 Arcana',
    body: 'Each position in your matrix is interpreted by crossing its meaning with one of the 22 major arcana of the tarot.',
  },
  {
    icon: 'check' as const,
    title: 'Free',
    body: 'Your complete matrix calculation is 100% free, no registration required, unlimited uses.',
  },
];
---

<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
  <h2 class="sr-only">Why Use Arcania</h2>
  <div class="grid gap-6 sm:grid-cols-3">
    {
      items.map((item) => (
        <Card class="text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-surface-alt text-primary">
            <Icon name={item.icon} class="h-6 w-6" />
          </div>
          <h3 class="mt-4 font-heading text-lg font-semibold text-ink">{item.title}</h3>
          <p class="mt-2 text-sm text-ink-muted">{item.body}</p>
        </Card>
      ))
    }
  </div>
</section>
