---
import { calculate } from '../../lib/matrix/calculate';
import MatrixChart from '../calculator/MatrixChart';

// A fixed sample date, purely illustrative — not tied to any real user.
// Rendered with no client: directive, so Astro emits static HTML for this
// chart and ships zero extra client JS; it's decorative only.
const sample = calculate({ day: 10, month: 10, year: 1990 });
---

<section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
  <h2 class="text-center font-heading text-2xl font-bold text-ink sm:text-3xl">What Your Result Looks Like</h2>
  <p class="mx-auto mt-3 max-w-xl text-center text-ink-muted">
    An illustrative example of the octagram you will get from your own date of birth.
  </p>
  {
    /*
      MatrixChart renders real <button> elements even without a client:
      directive, so aria-hidden alone would hide them from assistive tech
      while leaving them reachable by keyboard Tab (a real WCAG failure —
      caught by an axe-core audit). `inert` correctly removes the whole
      subtree from both the accessibility tree and the tab order.
    */
  }
  <div class="pointer-events-none mt-8" inert>
    <MatrixChart positions={sample.positions} activeKey={null} onSelect={() => {}} />
  </div>

  <dl class="mx-auto mt-6 grid max-w-md grid-cols-2 gap-x-4 gap-y-2 text-sm sm:grid-cols-3">
    <div class="flex items-baseline gap-1.5">
      <dt class="font-heading font-bold text-primary">A</dt>
      <dd class="text-ink-muted">Personality</dd>
    </div>
    <div class="flex items-baseline gap-1.5">
      <dt class="font-heading font-bold text-primary">B</dt>
      <dd class="text-ink-muted">Talents</dd>
    </div>
    <div class="flex items-baseline gap-1.5">
      <dt class="font-heading font-bold text-primary">C</dt>
      <dd class="text-ink-muted">Generational Energy</dd>
    </div>
    <div class="flex items-baseline gap-1.5">
      <dt class="font-heading font-bold text-primary">D</dt>
      <dd class="text-ink-muted">Mission</dd>
    </div>
    <div class="flex items-baseline gap-1.5">
      <dt class="font-heading font-bold text-primary">E</dt>
      <dd class="text-ink-muted">Center · Purpose</dd>
    </div>
  </dl>

  <p class="mx-auto mt-4 max-w-md text-center text-sm text-ink-muted">
    Each number is one of the 22 major arcana. Click to interpret it.
  </p>
</section>
