---
import Icon from '../ui/Icon.astro';

const items = [
  {
    icon: 'compass' as const,
    title: 'Purpose',
    body: 'Understand where your energy is directed and what mission you came to fulfil in this life.',
  },
  {
    icon: 'heart' as const,
    title: 'Relationships',
    body: 'Discover your masculine and feminine lines and how they influence your emotional connections.',
  },
  {
    icon: 'coins' as const,
    title: 'Money',
    body: 'Learn about your prosperity line and the blocks worth working on in your financial life.',
  },
  {
    icon: 'infinity' as const,
    title: 'Karma',
    body: 'Identify your karmic tail — the repeating patterns you can consciously transform.',
  },
];
---

<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
  <h2 class="text-center font-heading text-2xl font-bold text-ink sm:text-3xl">
    What You'll Discover in Your Matrix
  </h2>
  <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      items.map((item) => (
        <div class="text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-primary/10 text-primary">
            <Icon name={item.icon} class="h-7 w-7" />
          </div>
          <h3 class="mt-4 font-heading text-lg font-semibold text-ink">{item.title}</h3>
          <p class="mt-2 text-sm text-ink-muted">{item.body}</p>
        </div>
      ))
    }
  </div>
</section>
